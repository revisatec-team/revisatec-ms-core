                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const b = pm.response.json();",
                  "pm.test('Forma de lista paginada', () => {",
                  "  pm.expect(b).to.have.keys(['totalRecords','page','pageSize','items']);",
